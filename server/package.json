{
  "name": "asset-ledger-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude data-store.json --exclude \"*.log\" --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql && psql \"$DATABASE_URL\" -f db/schema-core.sql && psql \"$DATABASE_URL\" -f db/schema-transactions.sql",
    "db:schema:apply": "tsx --env-file=.env scripts/apply-schema.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate-to-postgres.ts",
    "db:check": "tsx --env-file=.env scripts/check-postgres.ts"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}